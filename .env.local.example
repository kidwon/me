# Copy to .env.local for local dev.
#
# NEXT_PUBLIC_CONVEX_URL is written automatically by `npx convex dev`.
# In CI it is provided by `npx convex deploy --cmd 'npm run build'`.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# DEEPSEEK_API_KEY lives in the Convex deployment, NOT here:
#   npx convex env set DEEPSEEK_API_KEY sk-your-deepseek-key

# Set only in CI (GitHub Pages serves the site under /me):
# NEXT_PUBLIC_BASE_PATH=/me
